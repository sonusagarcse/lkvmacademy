# ==============================================================================
# LKVM COURSES (LMS) - ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as '.env' and fill in your actual production credentials.
# NEVER commit your production '.env' file with real secrets to GitHub!
# ==============================================================================

# Application Environment
APP_NAME="LKVM Courses Academy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://courses.lkvmbihar.in

# Dedicated LMS Database Configuration
COURSES_DB_HOST=localhost
COURSES_DB_PORT=3306
COURSES_DB_USER=ouvcxwtd_courses
COURSES_DB_PASS=ouvcxwtd_courses
COURSES_DB_NAME=ouvcxwtd_courses

# Security & JWT Token Secrets
JWT_SECRET=change_this_to_a_secure_random_string_32_chars_or_more
SESSION_LIFETIME=86400

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

# UPI Direct Payment Receiver Details
UPI_MERCHANT_VPA=merchant@upi
UPI_MERCHANT_NAME="LKVM Academy"

# Administrator Defaults
ADMIN_DEFAULT_EMAIL=admin@lkvm.org
