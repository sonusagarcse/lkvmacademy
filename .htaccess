# ==============================================================================
# LKVM Courses Academy - Clean URL & Apache Routing Configuration
# Compatible with both domain root (https://courses.lkvmbihar.in/) and subfolders
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing and disable MultiViews negotiation
    Options -Indexes -MultiViews
    Options +FollowSymLinks

    # Default index files
    DirectoryIndex index.php index.html

    # MIME types for modern favicons
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType image/png .png

    # --------------------------------------------------------------------------
    # 1. External 301 Redirect: Hide .php from address bar
    # (Excludes /api/ endpoints and form POST submissions)
    # --------------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} !/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?#\s]+)\.php([?\s#]) [NC]
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^ %1 [R=301,L,NE]

    # --------------------------------------------------------------------------
    # 2. Compatibility: Strip /courses/ prefix if accessed on root domain
    # --------------------------------------------------------------------------
    RewriteRule ^courses/api/(.*)$ api/$1 [L,QSA]
    RewriteRule ^courses/uploads/(.*)$ uploads/$1 [L,QSA]
    RewriteRule ^courses/(.*)$ $1 [L,QSA]

    # --------------------------------------------------------------------------
    # 3. Pass-through existing physical files and directories (css, js, images, uploads, api)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------------------------------
    # 3. Course Clean Routing: /course/<slug> -> details.php?slug=<slug>
    # --------------------------------------------------------------------------
    RewriteRule ^course/([^/]+)/?$ details.php?slug=$1 [L,QSA]

    # --------------------------------------------------------------------------
    # 4. Internal Rewrite: Map extensionless URL to corresponding .php file
    # (Handles /login -> login.php, /categories -> categories.php, /admin/courses -> admin/courses.php)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

</IfModule>
